{
  "workspace_root": "~/task_workspaces",
  "repos_root": "~/repos",
  "repos": [
    {
      "name": "user-service",
      "path": "~/repos/user-service",
      "default_branch": "master",
      "keywords": ["登录", "用户", "账号", "user", "login", "auth", "注册"]
    },
    {
      "name": "auth-common",
      "path": "~/repos/auth-common",
      "default_branch": "master",
      "keywords": ["鉴权", "jwt", "token", "auth", "权限", "oauth"]
    },
    {
      "name": "api-gateway",
      "path": "~/repos/api-gateway",
      "default_branch": "main",
      "keywords": ["网关", "gateway", "路由", "proxy", "限流"]
    }
  ]
}
